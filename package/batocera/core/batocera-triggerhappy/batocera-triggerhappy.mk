################################################################################
#
# batocera-triggerhappy
#
################################################################################

BATOCERA_TRIGGERHAPPY_VERSION = 1.2
BATOCERA_TRIGGERHAPPY_LICENSE = GPL
BATOCERA_TRIGGERHAPPY_DEPENDENCIES = triggerhappy
BATOCERA_TRIGGERHAPPY_SOURCE =
BATOCERA_TRIGGERHAPPY_INSTALL_IMAGES = YES

define BATOCERA_TRIGGERHAPPY_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0644 -t $(TARGET_DIR)/etc/triggerhappy/triggers.d $(BATOCERA_TRIGGERHAPPY_PKGDIR)/conf/multimedia_keys.conf $(BATOCERA_TRIGGERHAPPY_PKGDIR)/conf/multimedia_keys_disabled.conf
	$(INSTALL) -D -m 0755 $(BATOCERA_TRIGGERHAPPY_PKGDIR)/99triggerhappy-resume $(TARGET_DIR)/etc/pm/sleep.d/99triggerhappy-resume
endef

define BATOCERA_TRIGGERHAPPY_INSTALL_IMAGES_CMDS
	$(INSTALL) -D -m 0755 $(BATOCERA_TRIGGERHAPPY_PKGDIR)/triggerhappy.service $(BINARIES_DIR)/batocera-target/etc/init.d/S50triggerhappy
endef

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_RK3326),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = rk3326
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_RK3399),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = rk3399
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_RK3128),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = rk3128
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_X86_64_ANY),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = x86_64
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_SM8250),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = sm8250
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_SM8550),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = sm8550
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_S922X),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = s922x
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_RK3568),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = rk3568
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_RK3576),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = rk3576
endif

ifeq ($(BR2_PACKAGE_BATOCERA_TARGET_H700),y)
BATOCERA_TRIGGERHAPPY_BOARD_CONF = h700
endif

ifneq ($(BATOCERA_TRIGGERHAPPY_BOARD_CONF),)
define BATOCERA_TRIGGERHAPPY_INSTALL_BOARD_CONFIG
	$(INSTALL) -D -m 0644 -t $(TARGET_DIR)/etc/triggerhappy/triggers.d $(BATOCERA_TRIGGERHAPPY_PKGDIR)/conf/$(BATOCERA_TRIGGERHAPPY_BOARD_CONF)/*.conf
endef
BATOCERA_TRIGGERHAPPY_POST_INSTALL_TARGET_HOOKS += BATOCERA_TRIGGERHAPPY_INSTALL_BOARD_CONFIG
endif

$(eval $(generic-package))
