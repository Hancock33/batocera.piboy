msgctxt "game_options"
msgid ""
"Fix screen tearing. Adaptive Sync (Default) synchronizes on video sync, "
"except for late frames (below target FPS) which are displayed immediately."
msgstr ""
"Correction du déchirement de l'écran. Adaptive Sync (par défaut) se "
"synchronise sur la synchronisation vidéo, à l'exception des images tardives "
"(en dessous du FPS cible) qui sont affichées immédiatement."

msgctxt "game_options"
msgid "Fix screen tearing. CPU heavy."
msgstr "Correction du déchirement de l'écran. Coûteux en CPU."

msgctxt "game_options"
msgid ""
"Fix screen tearing. FIFO (Vsync) does not drop frames. FIFO Relaxed allows "
"tearing as it recovers from a slow down. Mailbox can have lower latency but "
"may drop frames."
msgstr ""
"Corriger le déchirement de l'écran. FIFO (Vsync) ne perd pas d'images. FIFO "
"Relaxed permet le déchirement lorsqu'il récupère après un ralentissement. La "
"boîte aux lettres peut avoir une latence plus faible mais peut perdre des "
"images."

msgctxt "game_options"
