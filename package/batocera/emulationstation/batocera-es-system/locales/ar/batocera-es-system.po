msgstr ""
"تحسين. التبديل من استيفاء غاوسي (gaussian) الخاص بـ SNES إلى التكعيبي "
"(cubic). يُحسن جودة الصوت."

#. TRANSLATION: libretro/mupen64plus-next
msgctxt "game_options"
msgid "Enhancement. Upscale textures."
msgstr "تحسين. رفع دقة الإكساءات."

#. TRANSLATION: libretro/flycast, libretro/parallel_dc
