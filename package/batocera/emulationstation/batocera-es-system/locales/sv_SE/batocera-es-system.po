msgstr "Använd MAME:s programvarulistor för att identifiera ROM"

msgctxt "game_options"
msgid ""
"Use Megadrive to automap inputs for a Megadrive style controller with a 6 "
"button layout."
msgstr ""
"Använd Megadrive för att automatisera ingångar för en Megadrive-liknande "
"styrenhet med 6 knappar."

msgctxt "game_options"
msgid ""
"Use SSAA instead of MSAA for anti-aliasing. SSAA may look better but has a "
"higher performance cost."
msgstr ""
"Använd SSAA istället för MSAA för kantutjämning. SSAA kan se bättre ut men "
"har en högre prestandakostnad."

msgctxt "game_options"
msgid "Use a custom MAME config, do not overwrite config on launch."
msgstr ""
"Använd en anpassad MAME-konfiguration, skriv inte över konfigurationen vid "
"start."

msgctxt "game_options"
msgid "Use a specific mouse for Paddle 1, chosen by Port 1's Mouse Index."
msgstr "Använd en specifik mus för paddel 1, vald av musindex för port 1."

msgctxt "game_options"
msgid "Use a specific mouse for Paddle 2, chosen by Port 2's Mouse Index."
msgstr "Använd en specifik mus för paddel 2, vald av musindex för port 2."

msgctxt "game_options"
msgid "Use a specific mouse for Paddle 3, chosen by Port 3's Mouse Index."
