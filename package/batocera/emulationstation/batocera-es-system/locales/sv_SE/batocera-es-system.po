msgctxt "game_options"
msgid ""
"Fix screen tearing. Adaptive Sync (Default) synchronizes on video sync, "
"except for late frames (below target FPS) which are displayed immediately."
msgstr ""
"Åtgärdar bildsläpning. Adaptive Sync (standard) synkroniserar med "
"videosynkronisering, utom för sena bildrutor (under mål-FPS) som visas "
"omedelbart."

msgctxt "game_options"
msgid "Fix screen tearing. CPU heavy."
msgstr "Fixa bildsläpning. CPU-tung."

msgctxt "game_options"
msgid ""
"Fix screen tearing. FIFO (Vsync) does not drop frames. FIFO Relaxed allows "
"tearing as it recovers from a slow down. Mailbox can have lower latency but "
"may drop frames."
msgstr ""
"Fixar bildsläpning. FIFO (Vsync) släpper inte bildrutor. FIFO Relaxed "
"tillåter bildsläpning när den återhämtar sig från en långsam nedgång. "
"Brevlåda kan ha lägre latens men kan tappa bildrutor."

msgctxt "game_options"
msgid ""
"Fix screen tearing. Turn off to allow uncapped frame rates or variable "
"refresh rates (VRR)."
msgstr ""

msgctxt "game_options"
msgid ""
"Fix screen tearing. With Some games you need to turn VSync on in the games "
"options."
msgstr ""
"Fixa bildsläpning. I vissa spel måste du aktivera VSync i spelalternativen."

msgctxt "game_options"
msgid "Fix texture banding when upscaling."
msgstr "Fixar texturbandning vid uppskalning."

msgctxt "game_options"
