msgstr "Configuración de idioma y región de EmuTOS."

#. TRANSLATION: mupen64plus, ppsspp
msgctxt "game_options"
msgid "Enable"
msgstr "Activar"

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable / Disable automatic aiming."
msgstr "Activa o desactiva el apuntado automático."

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable / Disable fight music."
msgstr "Activa o desactiva la música de combate."

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable / Disable showing secret found messages."
msgstr "Activa o desactiva los mensajes que aparecen al encontrar secretos."

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable / Disable sound in menus."
msgstr "Activa o desactiva el sonido en los menús."

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable 16-channel iMuse Digital Audio."
msgstr "Activa el audio digital iMuse de 16 canales."

#. TRANSLATION: cemu
msgctxt "game_options"
msgid "Enable Cemu's performance overlay."
msgstr "Activa la superposición de rendimiento de Cemu."

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "Enable DMA for GPU. Some games require this for correct rendering."
msgstr ""

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "Enable FidelityFX Super Resolution upscaling."
msgstr ""

#. TRANSLATION: dolphin
msgctxt "game_options"
msgid ""
"Enable Gamecube boot animation and BIOS access (requires IPL.bin BIOS in "
"appropriate user directory)."
msgstr ""
"Activar la animación de inicio de GameCube y el acceso a la BIOS(requiere el "
"archivo IPL.bin en el directorio de usuario correspondiente)."

#. TRANSLATION: libretro/dosbox_pure
msgctxt "game_options"
msgid ""
"Enable Gravis Utrasound emulation. Ensure the ULTRASND folder is in the root "
"of your <game>.pc rom folder."
msgstr ""
"Activa la emulación de Gravis Ultrasound. Asegúrate de que la carpeta "
"ULTRASND esté en la raíz de la carpeta de ROM del juego <game>.pc."

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "Enable High Dynamic Range if your display supports it."
msgstr "Activa el alto rango dinámico (HDR) si tu pantalla es compatible."

#. TRANSLATION: melonds
msgctxt "game_options"
msgid ""
"Enable MelonDS to display over two screens. Some related screen options will "
"be ignored."
msgstr ""
"Permite que MelonDS se muestre en dos pantallas. Se ignorarán algunas "
"opciones de pantalla relacionadas."

#. TRANSLATION: armsx2, pcsx2
msgctxt "game_options"
msgid "Enable No-interlacing Patches."
msgstr "Activa los parches para eliminar el entrelazado."

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid ""
"Enable PS4 Pro (Neo) mode. Some games have enhanced graphics or performance "
"in Pro mode."
msgstr ""

#. TRANSLATION: moonlight
msgctxt "game_options"
msgid ""
"Enable QOS settings to optimise for internet or local network. Moonlight "
"Embedded only."
msgstr ""

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "Enable Robust Contrast-Adaptive Sharpening."
msgstr ""

#. TRANSLATION: libretro/stella
msgctxt "game_options"
msgid "Enable TV-like filtering / effects."
msgstr "Activa los filtros y efectos que simulan una televisión."

#. TRANSLATION: ppsspp
msgctxt "game_options"
msgid ""
"Enable UPnP for automatic port forwarding. Requires a compatible router."
msgstr ""

#. TRANSLATION: libretro/panda3ds
msgctxt "game_options"
msgid "Enable VSync"
msgstr ""

#. TRANSLATION: libretro/panda3ds
msgctxt "game_options"
msgid "Enable accurate shader multiplication"
msgstr ""

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable aiming crosshair."
msgstr "Activa la retícula de apuntado."

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable auto aiming."
msgstr "Activa el apuntado automático."

#. TRANSLATION: redream
msgctxt "game_options"
msgid "Enable auto frameskipping for performance on lower-end systems."
msgstr ""
"Activa el salto automático de fotogramas para mejorar el rendimiento en "
"sistemas de gama baja."

#. TRANSLATION: xenia-edge
msgctxt "game_options"
msgid ""
"Enable cache mount. Can improve performance and compatibility in some games."
msgstr ""
"Activa el montaje de la caché. Puede mejorar el rendimiento y la "
"compatibilidad en algunos juegos."

#. TRANSLATION: dolphin, rpcs3
msgctxt "game_options"
msgid "Enable controller rumble capabilities if supported by the controller."
msgstr "Activar la vibración del mando si es compatible."

#. TRANSLATION: supermodel
msgctxt "game_options"
msgid "Enable crosshairs in shooting games for the selected players."
msgstr ""
"Activa las miras en los juegos de disparos para los jugadores seleccionados."

#. TRANSLATION: linuxloader
msgctxt "game_options"
msgid ""
"Enable crosshairs in supported lightgun games (Ghost Squad Evolution, HotD4/"
"SP, Primeval Hunt, Rambo)."
msgstr ""

#. TRANSLATION: linuxloader
msgctxt "game_options"
msgid "Enable debug logging to assist with troubleshooting issues."
msgstr ""

#. TRANSLATION: libretro/bsnes_hd
msgctxt "game_options"
msgid "Enable for all scenes"
msgstr ""

#. TRANSLATION: linuxloader
msgctxt "game_options"
msgid "Enable free play for supported games."
msgstr "Activa el modo de juego libre en los juegos compatibles."

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable full subtitles on cutscenes."
msgstr "Activa los subtítulos completos en las secuencias cinemáticas."

#. TRANSLATION: wine
msgctxt "game_options"
msgid ""
"Enable gamepad HID raw access. This allow modern game to use special gamepad "
"features (like gyroscope for example), but can break older games with x-"
"input support only."
msgstr ""
"Activa el acceso directo HID al mando. Esto permite que los juegos modernos "
"utilicen funciones especiales del mando, como el giroscopio, pero puede "
"causar problemas en juegos antiguos que solo admiten XInput."

#. TRANSLATION: cemu
msgctxt "game_options"
msgid ""
"Enable gamepad view for games that have interaction across two screens. Use "
"Hotkey+R2 to switch screens."
msgstr ""
"Activa la vista del control para juegos que interactúan entre dos pantallas. "
"Usa Hotkey+R2 para cambiar de pantalla."

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable high dots per inch."
msgstr "Activar alta densidad de píxeles (DPI)."

#. TRANSLATION: sonic2013, soniccd
msgctxt "game_options"
msgid "Enable high quality effects for special stages."
msgstr "Activa los efectos de alta calidad para las fases especiales."

#. TRANSLATION: libretro/ep128emu
msgctxt "game_options"
msgid "Enable high quality sound processing."
msgstr ""

#. TRANSLATION: xroar
msgctxt "game_options"
msgid ""
"Enable host keyboard translation to map typed characters to the emulated "
"machine."
msgstr ""

#. TRANSLATION: xemu-chihiro
msgctxt "game_options"
msgid "Enable if the wheel is pushed away from centre instead of towards it."
msgstr ""

#. TRANSLATION: libretro/puae, libretro/puae2021
msgctxt "game_options"
msgid "Enable launching pre-installed WHDLoad installs."
msgstr "Permite iniciar instalaciones de WHDLoad preinstaladas."

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable lightsaber auto-camera."
msgstr "Activa la cámara automática del sable de luz."

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "Enable logging for the emulator developers."
msgstr ""

#. TRANSLATION: mame
msgctxt "game_options"
msgid ""
"Enable mouse input for trackballs, spinners, lightguns (if no gun "
"connected), and similar controls"
msgstr ""
"Activa la entrada del ratón para trackballs, controles giratorios, pistolas "
"de luz (si no hay ninguna conectada) y controles similares."

#. TRANSLATION: cemu
msgctxt "game_options"
msgid ""
"Enable mouse or touchpad input to simulate the Wii U GamePad touchscreen."
msgstr ""

#. TRANSLATION: cemu
msgctxt "game_options"
msgid "Enable notifications of cache, controller events etc."
msgstr "Activa las notificaciones de caché, eventos del control, etc."

#. TRANSLATION: corsixth
msgctxt "game_options"
msgid "Enable or Disable Intro movie (Enabled by default)."
msgstr ""
"Activa o desactiva el vídeo de introducción (activado de forma "
"predeterminada)."

#. TRANSLATION: xenia-edge
msgctxt "game_options"
msgid ""
"Enable or disable Xenia game patches. These patches can fix graphics and "
"compatibility problems."
msgstr ""

#. TRANSLATION: hypseus-singe
msgctxt "game_options"
msgid ""
"Enable or disable bezels being added when content is a 4:3 aspect with a "
"widescreen display."
msgstr ""
"Activa o desactiva la inclusión de marcos cuando el contenido tiene una "
"relación de aspecto 4:3 y se muestra en una pantalla panorámica."

#. TRANSLATION: libretro/mame, mame
msgctxt "game_options"
msgid "Enable or disable high score saving"
msgstr "Activa o desactiva el guardado de puntuaciones máximas."

#. TRANSLATION: libretro/mame, mame
msgctxt "game_options"
msgid "Enable per-game custom configuration via MAME menu."
msgstr ""
"Permite configurar opciones personalizadas para cada juego desde el menú de "
"MAME."

#. TRANSLATION: libretro/stella
msgctxt "game_options"
msgid "Enable phosphor mode (motion blur) for flickering effects."
msgstr ""
"Activa el modo de fósforo (desenfoque de movimiento) para los efectos de "
"parpadeo."

#. TRANSLATION: drastic
msgctxt "game_options"
msgid "Enable physical mic blowing. Higher sensitivity triggers more easily."
msgstr ""

#. TRANSLATION: supermodel
msgctxt "game_options"
msgid ""
"Enable proper quad rendering (for higher end x86 systems. Automatically "
"disabled on ARM/GLES systems)."
msgstr ""

#. TRANSLATION: libretro/ep128emu
msgctxt "game_options"
msgid "Enable resolution changes (requires restart)."
msgstr ""

#. TRANSLATION: openjkdf2
msgctxt "game_options"
msgid "Enable rotation on overlay map."
msgstr "Activa la rotación del mapa superpuesto."

#. TRANSLATION: mupen64plus
msgctxt "game_options"
msgid ""
"Enable second audio limiter. Improves audio quality at the cost of "
"performance."
msgstr ""
"Activa el segundo limitador de audio. Mejora la calidad del sonido a costa "
"del rendimiento."

#. TRANSLATION: libretro/panda3ds
msgctxt "game_options"
msgid "Enable shader JIT"
msgstr ""

#. TRANSLATION: vita3k
msgctxt "game_options"
msgid "Enable shader caching. Reduces stuttering on subsequent runs."
msgstr ""

#. TRANSLATION: libretro/opera
msgctxt "game_options"
msgid "Enable shared saves for multi-disc games"
msgstr "Activa los guardados compartidos para juegos de varios discos."

#. TRANSLATION: wine
msgctxt "game_options"
msgid "Enable support for Chinese, Japanese and Korean input methods."
msgstr ""
"Activa la compatibilidad con los métodos de entrada de chino, japonés y "
"coreano."

#. TRANSLATION: vita3k
msgctxt "game_options"
msgid "Enable texture caching. Improves performance in most apps."
msgstr ""

#. TRANSLATION: libretro/atari800
msgctxt "game_options"
msgid "Enable the BASIC interpreter. Some games need this."
msgstr "Activa el intérprete basico. Algunos juegos lo necesitan."

#. TRANSLATION: flycast, libretro/flycast
msgctxt "game_options"
msgid ""
"Enable the Dreamcast DSP for more accurate audio. Only recommended for fast "
"systems."
msgstr ""
"Activa el DSP de Dreamcast para obtener un audio más preciso. Solo se "
"recomienda en sistemas potentes."

#. TRANSLATION: linuxloader
msgctxt "game_options"
msgid ""
"Enable the IP address for OutRun 2 network play against another PC on the "
"same local network."
msgstr ""

#. TRANSLATION: amiberry
msgctxt "game_options"
msgid "Enable the Virtual Keyboard."
msgstr "Activa el teclado virtual."

#. TRANSLATION: duckstation
msgctxt "game_options"
msgid "Enable the cheat list (if available)."
msgstr "Activar la lista de trucos (si está disponible)."

#. TRANSLATION: vpinball
msgctxt "game_options"
msgid "Enable the custom values below."
msgstr "Activa los valores personalizados que aparecen a continuación."

#. TRANSLATION: easyrpg
msgctxt "game_options"
msgid "Enable the debug menu and the walk-through-walls button."
msgstr "Activa el menú de depuración y el botón para atravesar paredes."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid ""
"Enable this if your game's 3D modles are not rendered correctly. OpenGL "
"renderer only."
msgstr ""
"Activa esta opción si los modelos 3D del juego no se muestran "
"correctamente.Solo para el renderizador OpenGL."

#. TRANSLATION: linuxloader
msgctxt "game_options"
msgid ""
"Enable this to limit the FPS in games that are uncapped, such as OutRun 2."
msgstr ""

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid ""
"Enable to display an on-screen message if trying to use unsupported features."
msgstr ""
"Activa esta opción para mostrar un mensaje en pantalla al intentar utilizar "
"funciones no compatibles."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid "Enable to display if your BIOS haas known problems."
msgstr ""
"Activa esta opción para mostrar avisos si la BIOS presenta problemas "
"conocidos."

#. TRANSLATION: armsx2, pcsx2, pcsx2x6
msgctxt "game_options"
msgid "Enable to improve bluriness."
msgstr "Actívalo para mejorar la nitidez."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid "Enable to show whether the emulated screens are closed."
msgstr ""
"Activa esta opción para mostrar si las pantallas emuladas están cerradas."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid "Enable to show whether your device's camera is active."
msgstr ""
"Activa esta opción para mostrar si la cámara de tu dispositivo está activa."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid "Enable to show whether your device's microphone is active."
msgstr ""
"Activa esta opción para mostrar si el micrófono de tu dispositivo está "
"activo."

#. TRANSLATION: libretro/melondsds
msgctxt "game_options"
msgid ""
"Enable to show which screen layout with the configured sequence is active."
msgstr ""
"Activa esta opción para mostrar qué distribución de pantallas está activa "
"según la secuencia configurada."

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Enable to toggle fast forward instead of holding it down. Only on libretro "
"cores."
msgstr ""

#. TRANSLATION: sonicmania
msgctxt "game_options"
msgid "Enable triple buffering."
msgstr "Activa el triple búfer."

#. TRANSLATION: redream
msgctxt "game_options"
msgid "Enable vertical sync to avoid tearing in some cases."
msgstr ""
"Activa la sincronización vertical para evitar el desgarro de imagen en "
"algunos casos."

#. TRANSLATION: libretro/panda3ds
msgctxt "game_options"
msgid "Enable virtual SD card"
msgstr ""

#. TRANSLATION: bstone
msgctxt "game_options"
msgid "Enable widescreen support for game rendering."
msgstr ""
"Activa la compatibilidad con pantalla panorámica en el renderizado del juego."

#. TRANSLATION: theforceengine
msgctxt "game_options"
msgid "Enable widescreen support."
msgstr "Activar compatibilidad con pantalla panorámica."

#. TRANSLATION: dosbox_staging
msgctxt "game_options"
msgid "Enable writable overlay for squashfs ROMs"
msgstr ""

#. TRANSLATION: armsx2, bigpemu, bstone, cemu, cgenius, ...
msgctxt "game_options"
msgid "Enabled"
msgstr "Activado"

#. TRANSLATION: armsx2, bstone, corsixth, duckstation, f2bgl, ...
msgctxt "game_options"
msgid "Enabled (Default)"
msgstr "Activado (predeterminado)"

#. TRANSLATION: cgenius
msgctxt "game_options"
msgid "Enabled or disable the mouse cursor. Useful for CG's menus."
msgstr "Activa o desactiva el cursor del ratón. Útil para los menús de CG."

#. TRANSLATION: ppsspp
msgctxt "game_options"
msgid "Enables Action Replay cheats."
msgstr "Activa los trucos de Action Replay."

#. TRANSLATION: dolphin
msgctxt "game_options"
msgid "Enables Dolby Pro Logic II for surround sound. May impact performance."
msgstr ""
"Activa Dolby Pro Logic II para el sonido envolvente. Puede afectar al "
"rendimiento."

#. TRANSLATION: wine
msgctxt "game_options"
msgid ""
"Enables Vulkan Reflex low-latency mode to reduce input lag. Automatically "
"activates NVAPI if enabled."
msgstr ""

#. TRANSLATION: libretro/armsx2, libretro/pcsx2
msgctxt "game_options"
msgid "Enables cheats files to be read from the `cheats` directory."
msgstr "Permite leer archivos de trucos desde el directorio 'cheats'."

#. TRANSLATION: libretro/dolphin
msgctxt "game_options"
msgid "Enables or disable on screen messages."
msgstr "Activa o desactiva los mensajes en pantalla."

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Enables run-ahead. Doubles CPU requirements. High numbers can result in "
"visible jitter."
msgstr ""
"Activa la función Run-Ahead. Duplica los requisitos de CPU. Los valores "
"altos pueden provocar saltos visibles en la imagen."

#. TRANSLATION: moonlight
msgctxt "game_options"
msgid ""
"Enables surround sound if your audio card supports it (Consumes more "
"bandwidth)."
msgstr ""
"Activa el sonido envolvente si la tarjeta de sonido es compatible (consume "
"más ancho de banda)."

#. TRANSLATION: dolphin
msgctxt "game_options"
msgid ""
"Enabling will allow for correct emulation of texture wrapping. This comes at "
"a cost of potential worse performance."
msgstr ""
"Activarlo permite emular correctamente el envolvimiento de texturas, aunque "
"puede reducir el rendimiento."

#. TRANSLATION: duckstation
msgctxt "game_options"
msgid "Enabling will smooth out the image."
msgstr "Al activarlo, la imagen se verá más suave."

#. TRANSLATION: awgl, cemu, dolphin, doom3, eden, ...
msgctxt "game_options"
msgid "English"
msgstr "Inglés"

#. TRANSLATION: drastic, fallout1-ce, fallout2-ce, iortcw, libretro/cap32, ...
msgctxt "game_options"
msgid "English (Default)"
msgstr "Inglés (predeterminado)"

#. TRANSLATION: vita3k
msgctxt "game_options"
msgid "English (GB)"
msgstr ""

#. TRANSLATION: vita3k
msgctxt "game_options"
msgid "English (US)"
msgstr ""

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "English (United Kingdom)"
msgstr "Inglés (Reino Unido)"

#. TRANSLATION: shadps4
msgctxt "game_options"
msgid "English (United States)"
msgstr "Inglés (Estados Unidos)"

#. TRANSLATION: hatari, libretro/hatarib
msgctxt "game_options"
msgid "English (us)"
msgstr "Inglés (EE. UU.)"

#. TRANSLATION: dolphin
msgctxt "game_options"
msgid "English/Japanese"
msgstr "Inglés/japonés"

#. TRANSLATION: azahar
msgctxt "game_options"
msgid "Enhance low-resolution textures using scaling algorithms."
msgstr ""

#. TRANSLATION: libretro/ep128emu
msgctxt "game_options"
msgid "Enhanced"
msgstr ""

#. TRANSLATION: iortcw
msgctxt "game_options"
msgid "Enhanced OpenGL"
msgstr "OpenGL mejorado"

#. TRANSLATION: libretro/genesisplusgx-expanded
msgctxt "game_options"
msgid "Enhanced sound output support for compatible games."
msgstr "Compatibilidad con salida de sonido mejorada para juegos compatibles."

#. TRANSLATION: xemu
msgctxt "game_options"
msgid "Enhancement."
msgstr "Mejora gráfica."

#. TRANSLATION: libretro/mupen64plus-next
msgctxt "game_options"
msgid "Enhancement. 3 point is accurate to N64, standard is better."
msgstr ""
"Mejora: el filtrado de 3 puntos es fiel a la N64; el estándar ofrece mejores "
"resultados."

#. TRANSLATION: drastic
msgctxt "game_options"
msgid "Enhancement. Double the rendering resolution. Makes 3D objects clearer."
msgstr ""
"Mejora gráfica. Duplica la resolución de renderizado y hace que los objetos "
"3D se vean más nítidos."

#. TRANSLATION: melonds
msgctxt "game_options"
msgid "Enhancement. Enables improved polygon splitting."
msgstr "Mejora. Activa una división mejorada de polígonos."

#. TRANSLATION: mupen64plus
msgctxt "game_options"
msgid ""
"Enhancement. Improves clarity of distant textures when mip-mapping is "
"enabled."
msgstr ""
"Mejora. Aumenta la nitidez de las texturas lejanas cuando el mipmapping está "
"activado."

#. TRANSLATION: libretro/mupen64plus-next
msgctxt "game_options"
msgid ""
"Enhancement. Increase the rendering resolution when in 16:9 ratio. Makes 3D "
"objects clearer."
msgstr ""
"Mejora: aumenta la resolución de renderizado en formato 16:9. Hace que los "
"objetos 3D se vean más nítidos."

#. TRANSLATION: x16emu
msgctxt "game_options"
msgid "Enhancement. Increase the rendering resolution."
msgstr "Mejora: aumenta la resolución de renderizado."

#. TRANSLATION: armsx2, azahar, dolphin, duckstation, eden, ...
msgctxt "game_options"
msgid ""
"Enhancement. Increase the rendering resolution. Makes 3D objects clearer."
msgstr ""
"Mejora que aumenta la resolución de renderizado para que los objetos 3D se "
"vean más nítidos."

#. TRANSLATION: armsx2, dolphin, duckstation, libretro/dolphin, libretro/flycast, ...
msgctxt "game_options"
msgid "Enhancement. Only works with a 16/9 ratio and bezels disabled."
msgstr ""
"Mejora gráfica. Solo funciona con una relación de aspecto 16:9 y los marcos "
"decorativos desactivados."

#. TRANSLATION: openjazz
msgctxt "game_options"
msgid ""
"Enhancement. Pixel-art scaling filter applied to the low-resolution game "
"image before it's stretched to fill the render resolution. Scale2x needs an "
"integer scale factor of 2x or more."
msgstr ""

#. TRANSLATION: openjazz
msgctxt "game_options"
msgid ""
"Enhancement. Pixel-doubles the game image by this integer factor before "
"applying the scaler, as long as it still fits the render resolution."
msgstr ""

#. TRANSLATION: libretro/mesen-s, libretro/snes9x_next
msgctxt "game_options"
msgid "Enhancement. Reduces slowdown in mode 7 games."
msgstr ""
"Mejora que reduce las ralentizaciones en los juegos que utilizan el modo 7."

#. TRANSLATION: libretro/snes9x
msgctxt "game_options"
msgid ""
"Enhancement. Reduces slowdown in mode 7 games. Can cause issues in certain "
"games."
msgstr ""
"Mejora. Reduce la ralentización en los juegos con modo 7. Puede causar "
"problemas en algunos juegos."

#. TRANSLATION: libretro/fceumm, libretro/mame, libretro/mednafen_psx, libretro/mesen, libretro/mesen-s, ...
msgctxt "game_options"
msgid "Enhancement. Reduces system slowdown. Causes issues in some games."
msgstr ""
"Mejora que reduce las ralentizaciones del sistema. Puede causar problemas en "
"algunos juegos."

#. TRANSLATION: libretro/mednafen_psx
msgctxt "game_options"
msgid "Enhancement. Reduces wobbly polygons. Hardware renderer only."
msgstr ""

#. TRANSLATION: libretro/mesen
msgctxt "game_options"
msgid "Enhancement. Remove the eight sprite per line limit."
msgstr "Mejora que elimina el límite de ocho graficos por línea."

#. TRANSLATION: libretro/fceumm, libretro/nestopia
msgctxt "game_options"
msgid "Enhancement. Remove the eight sprites per line limit."
msgstr "Mejora. Elimina el límite de ocho sprites por línea."

#. TRANSLATION: libretro/genesisplusgx, libretro/genesisplusgx-expanded, libretro/picodrive
msgctxt "game_options"
msgid "Enhancement. Remove the eighty sprites per line limit."
msgstr "Mejora. Elimina el límite de ochenta graficos por línea."

#. TRANSLATION: libretro/bluemsx
msgctxt "game_options"
msgid "Enhancement. Remove the four sprites per line limit."
msgstr "Mejora que elimina el límite de cuatro graficos por línea."

#. TRANSLATION: libretro/mednafen_supergrafx, libretro/pce, libretro/pce_fast, libretro/pcfx
msgctxt "game_options"
msgid "Enhancement. Remove the sixteen sprites per line limit."
msgstr "Mejora: elimina el límite de dieciséis sprites por línea."

#. TRANSLATION: libretro/snes9x, libretro/snes9x_next
msgctxt "game_options"
msgid ""
"Enhancement. Remove the thirty-two sprites per line limit. Crashes certain "
"games."
msgstr ""
"Mejora. Elimina el límite de treinta y dos graficos por línea. Provoca "
"cierres inesperados en algunos juegos."

#. TRANSLATION: dolphin
msgctxt "game_options"
