msgctxt "game_options"
msgid "Enable logging for the emulator developers."
msgstr "Protokollierung für die Emulator-Entwickler aktivieren."

#. TRANSLATION: mame
msgctxt "game_options"
msgid ""
"Enable mouse input for trackballs, spinners, lightguns (if no gun "
"connected), and similar controls"
msgstr ""
"Aktivierung der Mauseingabe für Trackballs, Spinner, Lightguns (wenn nicht "
"verbunden) und ähnliche Steuerungen"

