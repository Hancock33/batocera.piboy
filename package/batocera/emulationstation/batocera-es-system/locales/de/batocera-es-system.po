msgctxt "game_options"
msgid "Enable rotation on overlay map."
msgstr "Rotation auf Overlay-Karte aktivieren."

#. TRANSLATION: mupen64plus
msgctxt "game_options"
msgid ""
"Enable second audio limiter. Improves audio quality at the cost of "
"performance."
msgstr ""
"Zweiten Audio-Limiter aktivieren. Verbesserung der Tonqualität auf Kosten "
"der Systemleistung."

