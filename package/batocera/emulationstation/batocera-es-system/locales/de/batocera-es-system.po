msgctxt "game_options"
msgid "Use the Nintendo DS BIOS/firmware if present."
msgstr "Nintendo-DS-BIOS/-Firmware verwenden, falls vorhanden."

#. TRANSLATION: libretro/mu
msgctxt "game_options"
msgid "Use the left analog stick to move the stylus."
msgstr "Linken Analogstick zum Bewegen des Stylus verwenden."

#. TRANSLATION: linuxloader
msgctxt "game_options"
