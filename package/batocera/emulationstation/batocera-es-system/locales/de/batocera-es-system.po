msgctxt "keys_files"
msgid "Use potion"
msgstr "Trank verwenden"

#. TRANSLATION: shared
msgctxt "game_options"
msgid ""
"Use preemptive frames instead of run-ahead. Only runs ahead when controller "
"state changes."
msgstr ""
"Benutze Präemptive Frames statt Run-Ahead. Führt nur dann einen Vorlauf aus, "
"wenn sich der Controllerstatus ändert."

#. TRANSLATION: libretro/skyemu
msgctxt "game_options"
msgid "Use the Game Boy Advance BIOS if present."
msgstr "Game-Boy-Advance-BIOS verwenden, falls vorhanden."

#. TRANSLATION: libretro/skyemu
msgctxt "game_options"
msgid "Use the Game Boy BIOS if present."
msgstr "Game-Boy-BIOS verwenden, falls vorhanden."

