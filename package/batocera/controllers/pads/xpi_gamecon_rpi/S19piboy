#!/bin/sh
DAEMON=/usr/bin/piboy-dmgcontrol.py
PIDFILE=/var/run/piboy-dmgcontrol.pid
enabled="$(batocera-settings-get -f /boot/batocera-boot.conf key piboy.enabled)"
enabledxrs="$(batocera-settings-get -f /boot/batocera-boot.conf key piboyxrs.enabled)"

start_daemon() {
	start-stop-daemon -S -q -b -m -p "$PIDFILE" --startas /usr/bin/python -- "$DAEMON"
}

case "$1" in
	start)
		echo always > /sys/kernel/mm/transparent_hugepage/enabled
		echo advise > /sys/kernel/mm/transparent_hugepage/shmem_enabled
		echo 0 > /proc/sys/vm/compaction_proactiveness
		echo 0 > /sys/kernel/mm/transparent_hugepage/khugepaged/defrag

		if [ "$enabled" = "1" ];then
			echo "Starting PiBoy"
			modprobe xpi_gamecon
			# the daemon handles the volume wheel through the xpi_gamecon volume node
			start_daemon
		elif [ "$enabledxrs" = "1" ];then
			echo "Starting PiBoy XRS"
			modprobe xpi_gamecon_xrs
			start_daemon
			touch /tmp/piboy_xrs
		fi

		if [ "$enabled" = "1" ] || [ "$enabledxrs" = "1" ];then
			touch /tmp/piboy
			dmesg -n 1
			# disable LCD display if HDMI is connected
			if grep -q -E '^connected' /sys/class/drm/card?-HDMI-A-*/status; then
				echo 0 >/sys/kernel/xpi_gamecon/flags
			fi > /dev/null 2>&1
		fi
		;;
	stop)
		if [ "$enabled" = "1" ] || [ "$enabledxrs" = "1" ];then
			echo "Stopping PiBoy"
			rm -f /tmp/piboy
			# SIGTERM lets the daemon save the battery state before it exits
			start-stop-daemon -K -q -o -p "$PIDFILE" > /dev/null 2>&1
			rm -f "$PIDFILE"

			# reboot requested
			if runlevel | grep -q -E '(6|unknown)$'; then
				echo "129" > /sys/kernel/xpi_gamecon/flags; sleep 1
			fi
			# shutdown requested
			if runlevel | grep -q '0$'; then
				echo "0" > /sys/kernel/xpi_gamecon/flags
				rmmod xpi_gamecon
				rmmod xpi_gamecon_xrs
			fi
		fi
		;;
	*)
		echo "Usage: /etc/init.d/S19piboy {start|stop}"
		exit 1
	;;
esac

exit 0
