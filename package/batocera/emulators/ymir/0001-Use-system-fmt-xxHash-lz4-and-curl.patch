From edf70e3c2d0cfd2740dcff5276358bf8e861a03d Mon Sep 17 00:00:00 2001
From: batocera <none@invalid>
Date: Sat, 21 Nov 2026 20:03:54 +0000
Subject: [PATCH 1/3] Use system fmt, xxHash, lz4 and curl

Use the fmt, xxHash and lz4 provided by the system instead of the
vendored copies, and link curl through the CURL::libcurl target, which
both CURLConfig.cmake and FindCURL provide, instead of the vcpkg-only
CURL::libcurl_static.

buildroot's libxxhash.pc points at /usr/local, so xxHash is looked up
directly rather than through pkg-config.
---
 apps/ymir-sdl3/CMakeLists.txt |  2 +-
 vendor/CMakeLists.txt         | 27 ++++++++++++---------------
 2 files changed, 13 insertions(+), 16 deletions(-)

diff --git a/apps/ymir-sdl3/CMakeLists.txt b/apps/ymir-sdl3/CMakeLists.txt
index 06609a7..2b29384 100644
--- a/apps/ymir-sdl3/CMakeLists.txt
+++ b/apps/ymir-sdl3/CMakeLists.txt
@@ -554,7 +554,7 @@ target_link_libraries(ymir-sdl3 PRIVATE
     lz4::lz4
     discord-rpc
     RtMidi::rtmidi
-    CURL::libcurl_static
+    CURL::libcurl
     stb::stb
     dr_libs::dr_libs
 )
diff --git a/vendor/CMakeLists.txt b/vendor/CMakeLists.txt
index 4b28ba2..dec9b6d 100644
--- a/vendor/CMakeLists.txt
+++ b/vendor/CMakeLists.txt
@@ -35,19 +35,23 @@ message(STATUS "Adding vendored libraries")
 message(STATUS "==> mio")
 add_subdirectory(mio EXCLUDE_FROM_ALL)
 
-# {fmt} - https://github.com/fmtlib/fmt
-message(STATUS "==> libfmt")
-set(FMT_MODULE OFF)
-add_subdirectory(fmt)
+# batocera - use system fmt, xxhash and lz4
+find_package(fmt CONFIG REQUIRED GLOBAL)
+find_package(PkgConfig REQUIRED)
+# buildroot's libxxhash.pc points at /usr/local
+find_path(XXHASH_INCLUDE_DIR xxhash.h REQUIRED)
+find_library(XXHASH_LIBRARY xxhash REQUIRED)
+add_library(xxHash::xxHash UNKNOWN IMPORTED GLOBAL)
+set_target_properties(xxHash::xxHash PROPERTIES
+    IMPORTED_LOCATION "${XXHASH_LIBRARY}"
+    INTERFACE_INCLUDE_DIRECTORIES "${XXHASH_INCLUDE_DIR}")
+pkg_check_modules(LZ4 REQUIRED IMPORTED_TARGET GLOBAL liblz4)
+add_library(lz4::lz4 ALIAS PkgConfig::LZ4)
 
 # concurrentqueue - https://github.com/cameron314/concurrentqueue
 message(STATUS "==> concurrentqueue")
 add_subdirectory(concurrentqueue EXCLUDE_FROM_ALL)
 
-# xxHash - https://github.com/Cyan4973/xxHash
-message(STATUS "==> xxHash")
-add_subdirectory(xxHash EXCLUDE_FROM_ALL)
-
 # libchdr - https://github.com/rtissera/libchdr
 message(STATUS "==> libchdr")
 add_subdirectory(libchdr)
@@ -79,11 +83,6 @@ if (NOT Ymir_LIBRARY_ONLY)
     message(STATUS "==> dear ImGui")
     add_subdirectory(imgui EXCLUDE_FROM_ALL)
 
-    # lz4 - https://github.com/lz4/lz4
-    # - Unable to configure AVX2 support from vcpkg
-    message(STATUS "==> lz4")
-    add_subdirectory(lz4 EXCLUDE_FROM_ALL)
-
     # discord-rpc - https://github.com/discord/discord-rpc
     # - Via myMCpp / PCSX2
     message(STATUS "==> discord-rpc")
@@ -95,10 +94,8 @@ endif ()
 if (MSVC)
     set_target_properties(chdr-lzma PROPERTIES FOLDER Vendored)
     set_target_properties(chdr-static PROPERTIES FOLDER Vendored)
-    set_target_properties(xxHash PROPERTIES FOLDER Vendored)
     if (NOT Ymir_LIBRARY_ONLY)
         set_target_properties(imgui PROPERTIES FOLDER Vendored)
-        set_target_properties(lz4 PROPERTIES FOLDER Vendored)
         set_target_properties(discord-rpc PROPERTIES FOLDER Vendored)
     endif ()
 endif ()
