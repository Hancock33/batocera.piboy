@@ -21,12 +21,55 @@
 #include "services/update_checker_service.hpp"
 #include "services/window_manager_service.hpp"
 
+#include <SDL3/SDL_gamepad.h>
+
+#include <algorithm>
 #include <chrono>
 #include <thread>
+#include <unordered_map>
 #include <vector>
 
 namespace app {
 
+// Maps gamepad instance IDs to player indices
+class PlayerIndexMap {
+public:
+    bool Contains(SDL_JoystickID id) const {
+        return m_playerIndices.contains(id);
+    }
+
+    int GetPlayerIndex(SDL_JoystickID id) const {
+        auto it = m_playerIndices.find(id);
+        return it != m_playerIndices.end() ? it->second : -1;
+    }
+
+    // Assigns the lowest player index not in use, so that indices pinned with AssignPlayerIndex(id, index) are skipped
+    int AssignPlayerIndex(SDL_JoystickID id) {
+        if (auto it = m_playerIndices.find(id); it != m_playerIndices.end()) {
+            return it->second;
+        }
+        int index = 0;
+        while (std::ranges::any_of(m_playerIndices, [&](const auto &entry) { return entry.second == index; })) {
+            ++index;
+        }
+        m_playerIndices[id] = index;
+        return index;
+    }
+
+    void AssignPlayerIndex(SDL_JoystickID id, int index) {
+        m_playerIndices[id] = index;
+    }
+
+    int ReleasePlayerIndex(SDL_JoystickID id) {
+        const int index = GetPlayerIndex(id);
+        m_playerIndices.erase(id);
+        return index;
+    }
+
+private:
+    std::unordered_map<SDL_JoystickID, int> m_playerIndices{};
+};
+
 class App {
 public:
     App();
@@ -73,6 +116,14 @@ private:
 
     // Rewind bar
     std::chrono::steady_clock::time_point m_rewindBarFadeTimeBase;
+
+    // Connected gamepads and their assigned player indices
+    // NOTE: SDL3 has a bug with Windows raw input where new controllers are always assigned to player index 0.
+    // We'll manage player indices manually instead.
+    std::unordered_map<SDL_JoystickID, SDL_Gamepad *> m_gamepads{};
+    PlayerIndexMap m_gamepadPlayerIndices{};
+
+    void MapConfiguredGamepads();
 };
 
 } // namespace app
