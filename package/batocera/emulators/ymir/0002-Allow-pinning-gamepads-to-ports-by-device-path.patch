+void App::MapConfiguredGamepads() {
+    // Open the gamepads whose device paths are set in the port settings and pin them to those ports, so that the
+    // player order does not depend on the order in which SDL enumerates the devices
+    int count = 0;
+    SDL_JoystickID *joysticks = SDL_GetJoysticks(&count);
+    if (joysticks == nullptr) {
+        return;
+    }
+
+    for (size_t port = 0; port < m_settings.input.ports.size(); ++port) {
+        const std::string devicePath = m_settings.input.ports[port].devicePath.string();
+        if (devicePath.empty()) {
+            continue;
+        }
+
+        for (int i = 0; i < count; ++i) {
+            const SDL_JoystickID id = joysticks[i];
+            if (m_gamepadPlayerIndices.Contains(id)) {
+                // Already pinned to another port
+                continue;
+            }
+
+            const char *path = SDL_GetJoystickPathForID(id);
+            if (path == nullptr || devicePath != path) {
+                continue;
+            }
+
+            if (SDL_Gamepad *gamepad = SDL_OpenGamepad(id)) {
+                const int playerIndex = static_cast<int>(port);
+                m_gamepadPlayerIndices.AssignPlayerIndex(id, playerIndex);
+                m_gamepads[id] = gamepad;
+                m_context.inputContext.ConnectGamepad(playerIndex);
+                devlog::debug<grp::base>("Gamepad {} ({}) mapped to port {}", id, path, port + 1);
+            }
+            break;
+        }
+    }
+
+    SDL_free(joysticks);
+}
+
 } // namespace app
