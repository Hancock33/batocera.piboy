From 6f5774757f4ac204e41a56db134c7b6efe70645d Mon Sep 17 00:00:00 2001
From: batocera <none@invalid>
Date: Sat, 21 Nov 2026 20:05:04 +0000
Subject: [PATCH 3/3] Do not show the menu bar when starting in fullscreen

The mouse hide timer started at launch, so the cursor and menu bar
were shown for the first seconds, and ImGui reported an invalid mouse
position near the top of the screen before the mouse ever moved.
Start the timer as already expired and ignore invalid mouse positions.
---
 apps/ymir-sdl3/src/app/app.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/apps/ymir-sdl3/src/app/app.cpp b/apps/ymir-sdl3/src/app/app.cpp
index ec16c2c..7d8eaa0 100644
--- a/apps/ymir-sdl3/src/app/app.cpp
+++ b/apps/ymir-sdl3/src/app/app.cpp
@@ -1300,7 +1300,7 @@ void App::RunEmulator() {
     m_context.saturn.instance->Reset(true);
 
     auto t = clk::now();
-    m_mouseHideTime = t;
+    m_mouseHideTime = t - std::chrono::seconds(2);
 
     // Start emulator thread
     StartEmulatorThread();
@@ -2129,6 +2129,10 @@ void App::RunEmulator() {
                 return false;
             }
 
+            if (!ImGui::IsMousePosValid()) {
+                return false;
+            }
+
             const float mousePosY = io.MousePos.y;
             const float vpTopQuarter =
                 viewport->Pos.y + std::min(viewport->Size.y * 0.25f, 120.0f * m_imguiData.displayScale);
-- 
