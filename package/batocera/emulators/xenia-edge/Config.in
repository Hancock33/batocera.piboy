config BR2_PACKAGE_XENIA_EDGE
	bool "xenia-edge"
	depends on BR2_x86_64 || BR2_aarch64
	depends on BR2_PACKAGE_XORG7 # libgtk3 X11 backend
	depends on BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_EXPAT
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_LIBGTK3_X11
	select BR2_PACKAGE_LZ4
	select BR2_PACKAGE_ZLIB
	# Runtime only: the binary uses the system libSDL3.so.0 and
	# dlopen()s libvulkan
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_VULKAN_LOADER

	help
	  Xenia is an open source research project for emulating
	  Xbox 360 games on modern PCs.

	  https://github.com/has207/xenia-edge

comment "xenia-edge needs X.org and OpenGL"
	depends on BR2_x86_64 || BR2_aarch64
	depends on !BR2_PACKAGE_XORG7 || !BR2_PACKAGE_HAS_LIBGL
