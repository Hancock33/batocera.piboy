Subject: [PATCH 3/3] Hide the menu bar in fullscreen

Remove the wx menu bar when entering fullscreen and restore it when
leaving, so it does not cover the top of the picture. When deciding
whether to size the render surface, check the window's own fullscreen
state rather than the wx frame's, which may not have switched yet.
---
 src/xenia/ui/window_wx.cc | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/xenia/ui/window_wx.cc b/src/xenia/ui/window_wx.cc
index d7a6874..4eac0c4 100644
--- a/src/xenia/ui/window_wx.cc
+++ b/src/xenia/ui/window_wx.cc
@@ -419,6 +419,16 @@ void WxWindow::ApplyNewFullscreen() {
   if (fullscreen && !frame_->IsFullScreen()) {
     SaveGeometryToConfig();
   }
+
+  if (fullscreen) {
+    frame_->SetMenuBar(nullptr);
+  } else {
+    auto* main_menu = static_cast<WxMenuItem*>(GetMainMenu());
+    if (main_menu && main_menu->GetMenuBar()) {
+      frame_->SetMenuBar(main_menu->GetMenuBar());
+    }
+  }
+
   frame_->ShowFullScreen(fullscreen);
   if (content_visibility_callback_) {
     content_visibility_callback_();
@@ -433,7 +443,7 @@ void WxWindow::EnsureInitialRenderSurfaceSize() {
   if (!frame_ || !render_panel_) {
     return;
   }
-  if (frame_->IsMaximized() || frame_->IsFullScreen()) {
+  if (frame_->IsMaximized() || IsFullscreen()) {
     return;
   }
   // Match render surface 1:1 with the cvar resolution (no DPI scaling).
