Subject: [PATCH] Generate version.h at configure time

Upstream writes version.h with xenia-build.py, which a plain CMake build
never runs. Generate it from CMake instead. The commit can be passed
with -DXE_BUILD_COMMIT, and git is only asked when the source tree is a
git checkout, so a build from a tarball does not pick up the commit of
whatever repository it was extracted into.
---
 CMakeLists.txt        |  4 ++++
 cmake/version_h.cmake | 54 +++++++++++++++++++++++++++++++++++++++++++
 src/version.h.in      |  9 ++++++++
 3 files changed, 67 insertions(+)
 create mode 100644 cmake/version_h.cmake
 create mode 100644 src/version.h.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 512b53d..48c64ec 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -462,3 +462,7 @@ add_subdirectory(third_party)
 add_subdirectory(src/xenia)
 
 set_property(DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} PROPERTY VS_STARTUP_PROJECT xenia-app)
+
+# Generate version.h
+include(cmake/version_h.cmake)
+generate_version_h()
diff --git a/cmake/version_h.cmake b/cmake/version_h.cmake
new file mode 100644
index 0000000..9d1630b
--- /dev/null
+++ b/cmake/version_h.cmake
@@ -0,0 +1,54 @@
+# Writes version.h into the build directory, which is on the include path.
+#
+# XE_BUILD_BRANCH, XE_BUILD_COMMIT and XE_BUILD_COMMIT_SHORT can be passed
+# with -D, e.g. when building from a tarball. Otherwise they are read from
+# git, but only if the source tree is a git checkout itself: running git
+# in an extracted tarball would report whatever repository contains it.
+function(generate_version_h)
+    message(STATUS "Generating version.h...")
+
+    if(NOT XE_BUILD_COMMIT AND EXISTS "${PROJECT_SOURCE_DIR}/.git")
+        find_package(Git)
+        if(Git_FOUND)
+            execute_process(
+                COMMAND ${GIT_EXECUTABLE} symbolic-ref --short -q HEAD
+                WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
+                OUTPUT_VARIABLE XE_BUILD_BRANCH
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+                )
+            execute_process(
+                COMMAND ${GIT_EXECUTABLE} log -1 --format=%H
+                WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
+                OUTPUT_VARIABLE XE_BUILD_COMMIT
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+                )
+            execute_process(
+                COMMAND ${GIT_EXECUTABLE} log -1 --format=%h
+                WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}
+                OUTPUT_VARIABLE XE_BUILD_COMMIT_SHORT
+                OUTPUT_STRIP_TRAILING_WHITESPACE
+                )
+        endif()
+    endif()
+
+    if(NOT XE_BUILD_BRANCH)
+        set(XE_BUILD_BRANCH "detached")
+    endif()
+    if(NOT XE_BUILD_COMMIT)
+        set(XE_BUILD_COMMIT "unknown")
+    endif()
+    if(NOT XE_BUILD_COMMIT_SHORT)
+        string(SUBSTRING "${XE_BUILD_COMMIT}" 0 7 XE_BUILD_COMMIT_SHORT)
+    endif()
+    message(STATUS "  Build branch: ${XE_BUILD_BRANCH}")
+    message(STATUS "  Git hash: ${XE_BUILD_COMMIT}")
+    message(STATUS "  Git hash (short): ${XE_BUILD_COMMIT_SHORT}")
+
+    if("$ENV{GITHUB_REF}" MATCHES "refs/pull/.*")
+        set(XE_BUILD_IS_PR TRUE)
+        string(REGEX REPLACE "refs/pull/([0-9]+)/.*" "\\1" XE_BUILD_PR_NUMBER "$ENV{GITHUB_REF}")
+        message(STATUS "  PR number: ${XE_BUILD_PR_NUMBER}")
+    endif()
+
+    configure_file(${PROJECT_SOURCE_DIR}/src/version.h.in ${CMAKE_BINARY_DIR}/version.h @ONLY)
+endfunction()
diff --git a/src/version.h.in b/src/version.h.in
new file mode 100644
index 0000000..37290b7
--- /dev/null
+++ b/src/version.h.in
@@ -0,0 +1,9 @@
+#ifndef GENERATED_VERSION_H_
+#define GENERATED_VERSION_H_
+#define XE_BUILD_BRANCH "@XE_BUILD_BRANCH@"
+#define XE_BUILD_COMMIT "@XE_BUILD_COMMIT@"
+#define XE_BUILD_COMMIT_SHORT "@XE_BUILD_COMMIT_SHORT@"
+#define XE_BUILD_DATE __DATE__
+#cmakedefine XE_BUILD_IS_PR
+#cmakedefine XE_BUILD_PR_NUMBER "@XE_BUILD_PR_NUMBER@"
+#endif  // GENERATED_VERSION_H_
