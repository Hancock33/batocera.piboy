diff --git a/core/sdl/evdev_lightgun.cpp b/core/sdl/evdev_lightgun.cpp
new file mode 100644
index 0000000..689fd86
--- /dev/null
+++ b/core/sdl/evdev_lightgun.cpp
@@ -0,0 +1,215 @@
+#ifdef __linux__
+
+#include "evdev_lightgun.h"
+#include "input/gamepad.h"
+#include "input/mouse.h"
+#include "stdclass.h"
+
+#include <libudev.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+#include <linux/input.h>
+#include <cstring>
+#include <algorithm>
+
+extern u32 kcode[4];
+
+std::vector<EvdevLightgun> EvdevLightgun::lightguns;
+std::atomic<bool> EvdevLightgun::running{false};
+std::thread EvdevLightgun::pollThread;
+
+EvdevLightgun::EvdevLightgun(int port, int fd, int minX, int maxX, int minY, int maxY)
+    : port(port)
+    , fd(fd)
+    , absXMin(minX)
+    , absXMax(maxX)
+    , absYMin(minY)
+    , absYMax(maxY)
+    , curX((minX + maxX) / 2)
+    , curY((minY + maxY) / 2)
+{
+}
+
+void EvdevLightgun::init()
+{
+    if (!lightguns.empty())
+        return;
+
+    struct udev *udev = udev_new();
+    if (!udev)
+        return;
+
+    struct udev_enumerate *enumerate = udev_enumerate_new(udev);
+    if (!enumerate)
+    {
+        udev_unref(udev);
+        return;
+    }
+
+    udev_enumerate_add_match_property(enumerate, "ID_INPUT_GUN", "1");
+    udev_enumerate_add_match_subsystem(enumerate, "input");
+    udev_enumerate_scan_devices(enumerate);
+
+    std::vector<std::string> gunDevices;
+    struct udev_list_entry *devices = udev_enumerate_get_list_entry(enumerate);
+    struct udev_list_entry *entry;
+
+    udev_list_entry_foreach(entry, devices)
+    {
+        const char *syspath = udev_list_entry_get_name(entry);
+        struct udev_device *dev = udev_device_new_from_syspath(udev, syspath);
+        if (dev)
+        {
+            const char *devnode = udev_device_get_devnode(dev);
+            if (devnode && strncmp(devnode, "/dev/input/event", 16) == 0)
+                gunDevices.push_back(devnode);
+            udev_device_unref(dev);
+        }
+    }
+
+    udev_enumerate_unref(enumerate);
+    udev_unref(udev);
+
+    std::sort(gunDevices.begin(), gunDevices.end());
+
+    for (const std::string& path : gunDevices)
+    {
+        if (lightguns.size() >= 4)
+            break;
+
+        int fd = open(path.c_str(), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+        if (fd < 0)
+            continue;
+
+        struct input_absinfo absX, absY;
+        if (ioctl(fd, EVIOCGABS(ABS_X), &absX) < 0 ||
+            ioctl(fd, EVIOCGABS(ABS_Y), &absY) < 0)
+        {
+            close(fd);
+            continue;
+        }
+
+        ioctl(fd, EVIOCGRAB, 1);
+
+        int port = (int)lightguns.size();
+        lightguns.emplace_back(port, fd, absX.minimum, absX.maximum, absY.minimum, absY.maximum);
+        NOTICE_LOG(INPUT, "Evdev lightgun on port %d: %s", port, path.c_str());
+    }
+
+    if (!lightguns.empty())
+    {
+        running = true;
+        pollThread = std::thread(pollAll);
+    }
+}
+
+void EvdevLightgun::term()
+{
+    running = false;
+    if (pollThread.joinable())
+        pollThread.join();
+
+    for (auto& gun : lightguns)
+        gun.closeDevice();
+    lightguns.clear();
+}
+
+void EvdevLightgun::closeDevice()
+{
+    if (fd < 0)
+        return;
+    ioctl(fd, EVIOCGRAB, 0);
+    close(fd);
+    fd = -1;
+}
+
+void EvdevLightgun::pollAll()
+{
+    std::vector<pollfd> fds(lightguns.size());
+
+    while (running)
+    {
+        for (size_t i = 0; i < lightguns.size(); i++)
+        {
+            // A negative fd is ignored by poll()
+            fds[i].fd = lightguns[i].fd;
+            fds[i].events = POLLIN;
+            fds[i].revents = 0;
+        }
+
+        // Wake up regularly to notice term() even if no gun is moving
+        int rc = ::poll(fds.data(), fds.size(), 100);
+        if (rc <= 0)
+            continue;
+
+        for (size_t i = 0; i < lightguns.size(); i++)
+        {
+            if (fds[i].revents & POLLIN)
+                lightguns[i].poll();
+            if (fds[i].revents & (POLLERR | POLLHUP | POLLNVAL))
+            {
+                NOTICE_LOG(INPUT, "Evdev lightgun on port %d disconnected", lightguns[i].port);
+                lightguns[i].closeDevice();
+            }
+        }
+    }
+}
+
+void EvdevLightgun::setButton(u32 button, bool pressed)
+{
+    if (pressed)
+        kcode[port] &= ~button;
+    else
+        kcode[port] |= button;
+}
+
+void EvdevLightgun::poll()
+{
+    if (fd < 0)
+        return;
+
+    struct input_event ev;
+    while (read(fd, &ev, sizeof(ev)) == sizeof(ev))
+    {
+        if (ev.type == EV_ABS)
+        {
+            if (ev.code == ABS_X)
+                curX = ev.value;
+            else if (ev.code == ABS_Y)
+                curY = ev.value;
+            else
+                continue;
+
+            int rangeX = std::max(absXMax - absXMin, 1);
+            int rangeY = std::max(absYMax - absYMin, 1);
+            int width = settings.display.width;
+            int height = settings.display.height;
+            int screenX = (int)(((int64_t)(curX - absXMin) * width) / rangeX);
+            int screenY = (int)(((int64_t)(curY - absYMin) * height) / rangeY);
+            SetMousePosition(screenX, screenY, width, height, port);
+        }
+        else if (ev.type == EV_KEY)
+        {
+            // Ignore auto-repeat
+            if (ev.value == 2)
+                continue;
+            bool pressed = ev.value != 0;
+
+            switch (ev.code)
+            {
+            case BTN_LEFT:   setButton(DC_BTN_A, pressed); break;
+            case BTN_RIGHT:  setButton(DC_BTN_B, pressed); break;
+            case BTN_MIDDLE: setButton(DC_BTN_START, pressed); break;
+            case BTN_1:      setButton(DC_BTN_D, pressed); break;
+            case BTN_5:      setButton(DC_DPAD_UP, pressed); break;
+            case BTN_6:      setButton(DC_DPAD_DOWN, pressed); break;
+            case BTN_7:      setButton(DC_DPAD_LEFT, pressed); break;
+            case BTN_8:      setButton(DC_DPAD_RIGHT, pressed); break;
+            }
+        }
+    }
+}
+
+#endif
diff --git a/core/sdl/evdev_lightgun.h b/core/sdl/evdev_lightgun.h
new file mode 100644
index 0000000..c54d448
--- /dev/null
+++ b/core/sdl/evdev_lightgun.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#ifdef __linux__
+
+#include "types.h"
+
+#include <atomic>
+#include <thread>
+#include <vector>
+
+// Reads light guns tagged ID_INPUT_GUN by udev directly from evdev, so their
+// absolute position and buttons reach the emulated guns on ports 0-3.
+class EvdevLightgun
+{
+public:
+    EvdevLightgun(int port, int fd, int minX, int maxX, int minY, int maxY);
+
+    static void init();
+    static void term();
+
+private:
+    void poll();
+    void closeDevice();
+    void setButton(u32 button, bool pressed);
+    static void pollAll();
+
+    int port;
+    int fd;
+    int absXMin, absXMax, absYMin, absYMax;
+    int curX, curY;
+
+    static std::vector<EvdevLightgun> lightguns;
+    static std::atomic<bool> running;
+    static std::thread pollThread;
+};
+
+#endif
