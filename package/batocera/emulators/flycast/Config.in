config BR2_PACKAGE_FLYCAST
	bool "flycast"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_GCC_ENABLE_OPENMP
	depends on BR2_PACKAGE_HAS_UDEV
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_BATOCERA_LAUNCH_FLYCAST
	select BR2_PACKAGE_GLSLANG if BR2_PACKAGE_BATOCERA_VULKAN
	select BR2_PACKAGE_LIBAO
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBMINIUPNPC
	select BR2_PACKAGE_LIBZIP
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ZLIB

	help
	  Flycast is a multi-platform Sega emulator for
	  - Dreamcast
	  - Naomi
	  - Atomiswave

	  https://github.com/flyinghead/flycast

comment "flycast needs a toolchain w/ C++ and OpenMP, udev and OpenGL or OpenGL ES"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_GCC_ENABLE_OPENMP || \
		!BR2_PACKAGE_HAS_UDEV || \
		(!BR2_PACKAGE_HAS_LIBGL && !BR2_PACKAGE_HAS_LIBGLES)
