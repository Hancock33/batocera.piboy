diff --git a/input/drivers_joypad/udev_joypad.c b/input/drivers_joypad/udev_joypad.c
index 8beb1480c6..57bf134017 100644
--- a/input/drivers_joypad/udev_joypad.c
+++ b/input/drivers_joypad/udev_joypad.c
@@ -99,6 +99,7 @@ struct udev_joypad
    int16_t axes[NUM_AXES];
    /* Deal with analog triggers that report -32767 to 32767 */
    bool neg_trigger[NUM_AXES];
+   int8_t trigger_rest[NUM_AXES];
 
    struct input_absinfo absinfo[NUM_AXES]; /* TODO/FIXME - unsure of alignment */
    bool axis_reported[NUM_AXES];
@@ -1172,6 +1173,10 @@ static int udev_add_pad(struct udev_device *dev, unsigned p, int fd, const char
             if (     (i == ABS_Z || i == ABS_RZ)
                   && udev_compute_axis(abs, abs->value) < -1300)
               pad->neg_trigger[axes] = true;
+            if (pad->axes[axes] > 0x7fff - 1300)
+               pad->trigger_rest[axes] = 1;
+            else if (pad->axes[axes] < -0x7fff + 1300)
+               pad->trigger_rest[axes] = -1;
             udev_joypad_view_axis(pad, axes);
             pad->axes_bind[i] = axes++;
          }
@@ -1886,6 +1891,8 @@ static int16_t udev_joypad_axis_state(
       /* Deal with analog triggers that report -32767 to 32767 */
       if (pad->neg_trigger[AXIS_NEG_GET(joyaxis)])
          val = (val + 0x7fff) / 2;
+      else if (pad->trigger_rest[AXIS_NEG_GET(joyaxis)] > 0)
+         val = (val - 0x7fff) / 2;
       if (val < 0)
          return val;
    }
@@ -1895,6 +1902,8 @@ static int16_t udev_joypad_axis_state(
       /* Deal with analog triggers that report -32767 to 32767 */
       if (pad->neg_trigger[AXIS_POS_GET(joyaxis)])
          val = (val + 0x7fff) / 2;
+      else if (pad->trigger_rest[AXIS_POS_GET(joyaxis)] < 0)
+         val = (val + 0x7fff) / 2;
       if (val > 0)
          return val;
    }
