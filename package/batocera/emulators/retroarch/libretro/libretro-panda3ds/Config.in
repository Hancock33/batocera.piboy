config BR2_PACKAGE_LIBRETRO_PANDA3DS
	bool "libretro-panda3ds"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_GLSLANG        if BR2_PACKAGE_BATOCERA_VULKAN
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_VULKAN_HEADERS if BR2_PACKAGE_BATOCERA_VULKAN
	select BR2_PACKAGE_VULKAN_LOADER  if BR2_PACKAGE_BATOCERA_VULKAN

	help
	  Panda3DS is an HLE, red-panda-themed Nintendo 3DS emulator.

	  https://github.com/wheremyfoodat/Panda3DS

comment "LIBRETRO_PANDA3DS needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
