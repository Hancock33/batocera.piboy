################################################################################
#
# libretro-flycast
#
################################################################################
# Version: Commits on Nov 21, 2026
LIBRETRO_FLYCAST_VERSION = 027b1054a457008ed5317732f456f9fbbb400df4
LIBRETRO_FLYCAST_SOURCE = flycast-$(LIBRETRO_FLYCAST_VERSION)-git4.tar.gz
LIBRETRO_FLYCAST_SITE = https://github.com/flyinghead/flycast.git
LIBRETRO_FLYCAST_SITE_METHOD = git
LIBRETRO_FLYCAST_GIT_SUBMODULES = YES
LIBRETRO_FLYCAST_LICENSE = GPL-2.0
LIBRETRO_FLYCAST_LICENSE_FILES = LICENSE
LIBRETRO_FLYCAST_EMULATOR_INFO = flycast.libretro.core.yml
LIBRETRO_FLYCAST_SUPPORTS_IN_SOURCE_BUILD = NO

# The core bundles its own libzip, zlib, zstd and miniupnpc
LIBRETRO_FLYCAST_DEPENDENCIES += retroarch

LIBRETRO_FLYCAST_CONF_OPTS += -DBUILD_SHARED_LIBS=OFF
LIBRETRO_FLYCAST_CONF_OPTS += -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF
LIBRETRO_FLYCAST_CONF_OPTS += -DLIBRETRO=ON
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_OPENMP=ON

# The tarball has no .git, so pass the version in (see 001-add-version.patch)
LIBRETRO_FLYCAST_GIT_HASH = $(shell echo $(LIBRETRO_FLYCAST_VERSION) | cut -c1-9)
LIBRETRO_FLYCAST_GIT_TAG = $(shell $(BR2_GIT) -C $(LIBRETRO_FLYCAST_DL_DIR)/git describe --tags --always $(LIBRETRO_FLYCAST_VERSION) 2>/dev/null || echo $(LIBRETRO_FLYCAST_GIT_HASH))
LIBRETRO_FLYCAST_CONF_OPTS += -DGIT_VERSION=$(LIBRETRO_FLYCAST_GIT_TAG)
LIBRETRO_FLYCAST_CONF_OPTS += -DGIT_HASH=$(LIBRETRO_FLYCAST_GIT_HASH)

# OpenGL backend
ifeq ($(BR2_PACKAGE_HAS_LIBGL),y)
LIBRETRO_FLYCAST_DEPENDENCIES += libgl
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_OPENGL=ON -DUSE_GLES=OFF -DUSE_GLES2=OFF
else ifeq ($(BR2_PACKAGE_BATOCERA_GLES3),y)
LIBRETRO_FLYCAST_DEPENDENCIES += libgles
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_GLES=ON -DUSE_GLES2=OFF
else ifeq ($(BR2_PACKAGE_BATOCERA_GLES2),y)
LIBRETRO_FLYCAST_DEPENDENCIES += libgles
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_GLES=OFF -DUSE_GLES2=ON
endif

# Vulkan backend, using the system glslang instead of the bundled one
ifeq ($(BR2_PACKAGE_BATOCERA_VULKAN),y)
LIBRETRO_FLYCAST_DEPENDENCIES += glslang
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_VULKAN=ON -DUSE_HOST_GLSLANG=ON
else
LIBRETRO_FLYCAST_CONF_OPTS += -DUSE_VULKAN=OFF
endif

define LIBRETRO_FLYCAST_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/buildroot-build/flycast_libretro.so \
		$(TARGET_DIR)/usr/lib/libretro/flycast_libretro.so
endef

$(eval $(cmake-package))
$(eval $(emulator-info-package))
