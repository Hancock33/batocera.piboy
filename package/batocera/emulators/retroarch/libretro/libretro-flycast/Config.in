config BR2_PACKAGE_LIBRETRO_FLYCAST
	bool "libretro-flycast"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_GCC_ENABLE_OPENMP
	depends on BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL
	select BR2_PACKAGE_GLSLANG if BR2_PACKAGE_BATOCERA_VULKAN

	help
	  Flycast libretro core, a Sega Dreamcast, Naomi and
	  Atomiswave emulator.

	  https://github.com/flyinghead/flycast

comment "libretro-flycast needs a toolchain w/ C++ and OpenMP, and OpenGL or OpenGL ES"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_GCC_ENABLE_OPENMP || \
		(!BR2_PACKAGE_HAS_LIBGLES && !BR2_PACKAGE_HAS_LIBGL)
