Subject: [PATCH] Allow GIT_VERSION and GIT_HASH to be set on the command line

Buildroot builds from a tarball with no .git directory, so the version
would always be reported as v0.0.0. Only fall back to the placeholder
when the values were not passed with -D.
---
 CMakeLists.txt | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index fee2357..c9bce3a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -149,8 +149,12 @@ if(GIT_FOUND AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/.git")
 		OUTPUT_STRIP_TRAILING_WHITESPACE
 	)
 else()
-	set(GIT_VERSION "v0.0.0-0-g000000000")
-	set(GIT_HASH "000000000")
+	if(NOT DEFINED GIT_VERSION)
+		set(GIT_VERSION "v0.0.0-0-g000000000")
+	endif()
+	if(NOT DEFINED GIT_HASH)
+		set(GIT_HASH "000000000")
+	endif()
 endif()
 
 if(WINDOWS_STORE)
