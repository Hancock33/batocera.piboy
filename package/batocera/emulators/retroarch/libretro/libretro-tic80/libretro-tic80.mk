# Version: Commits on Nov 22, 2026
LIBRETRO_TIC80_VERSION = 7656cf4ba0d4c4b8034fb2ee8490e0daa0d607f6
LIBRETRO_TIC80_SITE = https://github.com/nesbox/TIC-80.git
LIBRETRO_TIC80_SITE_METHOD=git
LIBRETRO_TIC80_GIT_SUBMODULES=YES
LIBRETRO_TIC80_LICENSE = MIT
LIBRETRO_TIC80_LICENSE_FILES = LICENSE
LIBRETRO_TIC80_SUPPORTS_IN_SOURCE_BUILD = NO
LIBRETRO_TIC80_DEPENDENCIES = retroarch
LIBRETRO_TIC80_EMULATOR_INFO = tic80.libretro.core.yml

LIBRETRO_TIC80_CONF_OPTS += -DBUILD_LIBRETRO=ON
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_SDL=OFF
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_SOKOL=OFF
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_STATIC=ON
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_WITH_ALL=ON
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_WITH_GRAVITY=OFF
LIBRETRO_TIC80_CONF_OPTS += -DBUILD_WITH_RUBY=OFF
LIBRETRO_TIC80_CONF_OPTS += -DPREFER_SYSTEM_LIBRARIES=OFF

define LIBRETRO_TIC80_INSTALL_TARGET_CMDS
	$(INSTALL) -D $(@D)/buildroot-build/bin/tic80_libretro.so $(TARGET_DIR)/usr/lib/libretro/tic80_libretro.so
endef

$(eval $(cmake-package))
$(eval $(emulator-info-package))
