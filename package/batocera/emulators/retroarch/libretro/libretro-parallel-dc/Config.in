config BR2_PACKAGE_LIBRETRO_PARALLEL_DC
	bool "libretro-parallel-dc"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_GCC_ENABLE_OPENMP
	depends on (BR2_PACKAGE_HAS_LIBGLES || BR2_PACKAGE_HAS_LIBGL)

	help
	  ParaLLEl-DC libretro core: Sega Dreamcast, Naomi, Naomi 2 and
	  Atomiswave emulation for RetroArch. Derived from Flycast by
	  flyinghead.

	  https://github.com/libretro/parallel-dc

comment "LIBRETRO_PARALLEL_DC needs a toolchain w/ C++, OpenMP and OpenGL ES or OpenGL"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_GCC_ENABLE_OPENMP || \
	  (!BR2_PACKAGE_HAS_LIBGLES && !BR2_PACKAGE_HAS_LIBGL)
