config BR2_PACKAGE_LIBRETRO_AMIBERRY
	bool "libretro-amiberry"
	depends on BR2_INSTALL_LIBSTDCPP
	select BR2_PACKAGE_ZLIB

	help
	  Amiberry libretro core, an optimised Amiga emulator based on
	  UAE, for the Amiga 500, 1200, CD32 and CDTV.

	  The Kickstart ROMs are required in bios/amiga.

	  https://github.com/BlitterStudio/amiberry

comment "LIBRETRO_AMIBERRY needs a toolchain w/ C++"
	depends on !BR2_INSTALL_LIBSTDCPP
