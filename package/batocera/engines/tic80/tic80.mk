################################################################################
#
# tic80
#
################################################################################
# Version: Commits on Nov 21, 2026
TIC80_VERSION = 9dcd4b545f4032ee76729c223af285cb2ca3ff92
TIC80_SITE = https://github.com/nesbox/TIC-80.git
TIC80_SITE_METHOD = git
TIC80_GIT_SUBMODULES = YES
TIC80_LICENSE = MIT
TIC80_LICENSE_FILES = LICENSE
TIC80_SUPPORTS_IN_SOURCE_BUILD = NO
TIC80_EMULATOR_INFO = tic80.emulator.yml
TIC80_DEPENDENCIES = libcurl sdl2

TIC80_CONF_OPTS += -DBUILD_SDL=ON
TIC80_CONF_OPTS += -DBUILD_SOKOL=OFF
TIC80_CONF_OPTS += -DBUILD_SDLGPU=ON
TIC80_CONF_OPTS += -DBUILD_STATIC=ON
TIC80_CONF_OPTS += -DBUILD_PRO=TRUE
TIC80_CONF_OPTS += -DBUILD_TOUCH_INPUT=ON
TIC80_CONF_OPTS += -DBUILD_WITH_ALL=ON
TIC80_CONF_OPTS += -DBUILD_WITH_GRAVITY=OFF
TIC80_CONF_OPTS += -DBUILD_WITH_RUBY=OFF
TIC80_CONF_OPTS += -DPREFER_SYSTEM_LIBRARIES=OFF
TIC80_CONF_OPTS += -DPREFER_SYSTEM_SDL2=ON

ifeq ($(BR2_PACKAGE_HAS_LIBGL),y)
TIC80_DEPENDENCIES += libgl libglu
else ifeq ($(BR2_PACKAGE_HAS_LIBGLES),y)
TIC80_DEPENDENCIES += libgles
TIC80_CONF_OPTS += -DUSE_GLES2=ON
endif

ifeq ($(BR2_PACKAGE_ALSA_LIB),y)
TIC80_DEPENDENCIES += alsa-lib
endif

define TIC80_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/buildroot-build/bin/tic80 $(TARGET_DIR)/usr/bin/tic80
endef

$(eval $(cmake-package))
$(eval $(emulator-info-package))
