config BR2_PACKAGE_SCUMMVM
	bool "scummvm"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_FLUIDSYNTH
	select BR2_PACKAGE_FAAD2
	select BR2_PACKAGE_FLAC
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_JPEG
	select BR2_PACKAGE_LIBMAD
	select BR2_PACKAGE_LIBMPEG2
	select BR2_PACKAGE_LIBOGG
	select BR2_PACKAGE_LIBPNG
	select BR2_PACKAGE_LIBTHEORA
	select BR2_PACKAGE_LIBVORBIS if !(BR2_arm || BR2_mipsel)
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_TREMOR if BR2_arm || BR2_mipsel
	select BR2_PACKAGE_ZLIB

	help
	  ScummVM lets you run classic point-and-click adventure and
	  role-playing games, provided you have their data files.

	  https://www.scummvm.org/

comment "scummvm needs a toolchain w/ C++ and fluidsynth"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_FLUIDSYNTH
