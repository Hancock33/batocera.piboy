+    # vorbis_add_libraries(<suffix> <SHARED|STATIC>)
+    # Creates vorbis<suffix>, vorbisenc<suffix> and vorbisfile<suffix>.
+    function(vorbis_add_libraries suffix type)
+        set(_vorbis vorbis${suffix})
+        set(_vorbisenc vorbisenc${suffix})
+        set(_vorbisfile vorbisfile${suffix})
+
+        if(type STREQUAL "SHARED")
+            set(_vorbis_def ${VORBIS_DEF_FILE})
+            set(_vorbisenc_def ${VORBISENC_DEF_FILE})
+            set(_vorbisfile_def ${VORBISFILE_DEF_FILE})
+        endif()
+
+        add_library(${_vorbis} ${type} ${VORBIS_HEADERS} ${VORBIS_SOURCES} ${_vorbis_def})
+        add_library(${_vorbisenc} ${type} ${VORBISENC_SOURCES} ${_vorbisenc_def})
+        add_library(${_vorbisfile} ${type} ${VORBISFILE_SOURCES} ${_vorbisfile_def})
+
+        if(type STREQUAL "SHARED")
+            set_target_properties(${_vorbis} PROPERTIES SOVERSION ${VORBIS_VERSION_INFO})
+            set_target_properties(${_vorbisenc} PROPERTIES SOVERSION ${VORBISENC_VERSION_INFO})
+            set_target_properties(${_vorbisfile} PROPERTIES SOVERSION ${VORBISFILE_VERSION_INFO})
+        elseif(NOT suffix STREQUAL "" AND NOT MSVC)
+            # Keep the usual libvorbis*.a names next to the shared libraries.
+            # MSVC is excluded because vorbis.lib is already the import library.
+            set_target_properties(${_vorbis} PROPERTIES OUTPUT_NAME vorbis)
+            set_target_properties(${_vorbisenc} PROPERTIES OUTPUT_NAME vorbisenc)
+            set_target_properties(${_vorbisfile} PROPERTIES OUTPUT_NAME vorbisfile)
+        endif()
+
+        target_include_directories(${_vorbis}
+            PUBLIC
+                $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
+                $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+            PRIVATE
+                ${CMAKE_CURRENT_SOURCE_DIR}
+        )
+        target_include_directories(${_vorbisenc}
+            PUBLIC
+                $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
+                $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+            PRIVATE
+                ${CMAKE_CURRENT_SOURCE_DIR}
+        )
+        target_include_directories(${_vorbisfile}
+            PUBLIC
+                $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/include>
+                $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>
+        )
+
+        target_link_libraries(${_vorbis}
+            PUBLIC Ogg::ogg
+            PRIVATE $<$<BOOL:${HAVE_LIBM}>:m>
+        )
+        target_link_libraries(${_vorbisenc} PUBLIC ${_vorbis})
+        target_link_libraries(${_vorbisfile} PUBLIC ${_vorbis})
+
+        set(VORBIS_INSTALL_TARGETS ${VORBIS_INSTALL_TARGETS}
+            ${_vorbis} ${_vorbisenc} ${_vorbisfile} PARENT_SCOPE)
+    endfunction()
