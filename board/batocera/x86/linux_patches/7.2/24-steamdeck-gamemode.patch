diff --git a/drivers/hid/hid-steam.c b/drivers/hid/hid-steam.c
--- a/drivers/hid/hid-steam.c
+++ b/drivers/hid/hid-steam.c
@@ -1112,7 +1112,9 @@
 	hid_info(steam->hdev, "Steam Controller '%s' connected",
 			steam->serial_no);
 
-	steam_set_lizard_mode(steam, lizard_mode);
+	/* start in gamepad mode */
+	steam->gamepad_mode = true;
+	steam_set_lizard_mode(steam, false);
 	mutex_unlock(&steam->report_mutex);
 
 	/* ignore battery errors, we can live without it */
@@ -1832,15 +1834,16 @@
 static void steam_do_deck_input_event(struct steam_device *steam,
 		struct input_dev *input, u8 *data)
 {
-	bool start_pressed;
+	bool start_pressed, base_pressed;
 	bool lpad_touched, rpad_touched;
 
-	start_pressed = data[9] & BIT(6);
+	start_pressed = data[9] & BIT(5);
+	base_pressed = data[14] & BIT(2);
 
-	if (!start_pressed && steam->did_mode_switch) {
+	if ((!start_pressed && !base_pressed) && steam->did_mode_switch) {
 		steam->did_mode_switch = false;
 		cancel_delayed_work(&steam->mode_switch);
-	} else if (!steam->client_opened && start_pressed && !steam->did_mode_switch) {
+	} else if (!steam->client_opened && (start_pressed && base_pressed) && !steam->did_mode_switch) {
 		hid_dbg(steam->hdev, "%s: doing mode switch\n", __func__);
 		steam->did_mode_switch = true;
 		schedule_delayed_work(&steam->mode_switch, 45 * HZ / 100);
