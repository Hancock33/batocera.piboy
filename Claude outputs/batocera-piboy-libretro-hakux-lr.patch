diff --git a/package/batocera/emulators/retroarch/libretro/libretro-hakux-lr/libretro-hakux-lr.mk b/package/batocera/emulators/retroarch/libretro/libretro-hakux-lr/libretro-hakux-lr.mk
new file mode 100644
index 000000000..01beb7c55
--- /dev/null
+++ b/package/batocera/emulators/retroarch/libretro/libretro-hakux-lr/libretro-hakux-lr.mk
@@ -0,0 +1,40 @@
+################################################################################
+#
+# libretro-hakux-lr
+#
+################################################################################
+
+# Version: Release linux-v0.32.2
+LIBRETRO_HAKUX_LR_VERSION = f850f6c8b11d0616251fedd320bfd3bfe3961f56
+LIBRETRO_HAKUX_LR_SITE = https://github.com/portare-ch/hakuX-lr.git
+LIBRETRO_HAKUX_LR_SITE_METHOD = git
+LIBRETRO_HAKUX_LR_GIT_SUBMODULES = YES
+LIBRETRO_HAKUX_LR_SUBDIR = native
+LIBRETRO_HAKUX_LR_LICENSE = GPL-2.0+
+LIBRETRO_HAKUX_LR_LICENSE_FILES = LICENSE licenses/GPL-2.0.txt
+LIBRETRO_HAKUX_LR_EMULATOR_INFO = hakux-lr.libretro.core.yml
+LIBRETRO_HAKUX_LR_DEPENDENCIES += retroarch
+
+LIBRETRO_HAKUX_LR_SUPPORTS_IN_SOURCE_BUILD = NO
+
+# x86-64 only: the guest CPU runs on KVM
+LIBRETRO_HAKUX_LR_CONF_OPTS += -DHAKUX_BUILD_LIBRETRO=ON
+LIBRETRO_HAKUX_LR_CONF_OPTS += -DHAKUX_BUILD_APP=OFF
+LIBRETRO_HAKUX_LR_CONF_OPTS += -DHAKUX_BUILD_TESTS=OFF
+LIBRETRO_HAKUX_LR_CONF_OPTS += -DHAKUX_CPU=kvm
+LIBRETRO_HAKUX_LR_CONF_OPTS += -DHAKUX_VERSION=$(LIBRETRO_HAKUX_LR_VERSION)
+
+# TODO: the upstream build also pins 11 external sources and 6 FEX submodules
+# in tools/native/linux-deps.json, fetched by tools/native/linux-deps.py, and
+# expects Clang 19 and Rust 1.99.1. None of that is wired in yet, so this
+# package has not been built.
+
+define LIBRETRO_HAKUX_LR_INSTALL_TARGET_CMDS
+	$(INSTALL) -D $(@D)/buildroot-build/hakux_libretro.so \
+		$(TARGET_DIR)/usr/lib/libretro/hakux_libretro.so
+	$(INSTALL) -D $(@D)/native/libretro/hakux_libretro.info \
+		$(TARGET_DIR)/usr/share/libretro/info/hakux_libretro.info
+endef
+
+$(eval $(cmake-package))
+$(eval $(emulator-info-package))
