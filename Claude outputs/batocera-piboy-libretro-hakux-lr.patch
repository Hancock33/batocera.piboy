+config BR2_PACKAGE_LIBRETRO_HAKUX_LR
+	bool "libretro-hakux-lr"
+	depends on BR2_x86_64
+	depends on BR2_INSTALL_LIBSTDCPP
+
+	help
+	  hakuX-lr: an original Xbox emulator core for RetroArch (x86-64 only,
+	  uses KVM; requires /dev/kvm).
+
+	  https://github.com/portare-ch/hakuX-lr
+
+comment "LIBRETRO_HAKUX_LR needs an x86-64 toolchain with C++"
+	depends on !BR2_x86_64 || !BR2_INSTALL_LIBSTDCPP
